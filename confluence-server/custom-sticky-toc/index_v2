<!-- barquerohr: version two removes old calc method of guessing padding for top and bottom, hardcodes them instead for predictability. Adds zindex overrides, and aui overrides to allow flyout menus to work while hiding labels. -->

<style>
  .wiki-content .columnLayout {
    display: flex;
  }

  .wiki-content .contentLayout2 .columnLayout .cell {
    padding-left: 15px;
    padding-right: 55px;
  }

  .wiki-content .columnLayout .cell.aside {          
    position: fixed;
    width: calc(20% - 10px);
    top: 170px;
    bottom: 40px;
    z-index: 100;
    background: white;
    box-sizing: border-box;
    overflow-y: auto;
    right: 0;
  }

  .wiki-content .columnLayout .cell.aside.toc-hidden-for-menu {
    display: none;
  }

  .toc-macro {
    font-size: 16px;
  }

  .wiki-content .columnLayout .cell:not(.aside) {
    margin-right: calc(20%);
  }

  .back-to-top-container {
    text-align: right;
    margin-top: 10px;
    padding-bottom: 20px;
  }

  .back-to-top-btn {
    display: inline-block;
    padding: 10px 20px;
    background-color: #1d1d1d;
    color: white !important;
    text-decoration: none;
    font-size: 16px;
    cursor: pointer;
    border-radius: 5px;
    margin-right: 30px;
  }
</style>

<!-- barquerohr: back to top button, use this if you want a one-click method to go up to start of page -->

<div class="back-to-top-container">
  <a href="#" class="back-to-top-btn" onclick="scrollToTop()">Back to top</a>
</div>

<script>
  function scrollToTop() {
    AJS.$('html, body').animate({ scrollTop: 0 }, 'fast');
    return false;
  }

  (function () {
    function isVisible(el) {
      const style = window.getComputedStyle(el);
      const rect = el.getBoundingClientRect();

      return (
        style.display !== 'none' &&
        style.visibility !== 'hidden' &&
        rect.width > 0 &&
        rect.height > 0
      );
    }

<!-- barquerohr: listener to hide aui-header when opened behind the toc -->
    function updateTocVisibility() {
      const toc = document.querySelector('.wiki-content .columnLayout .cell.aside');
      if (!toc) return;

      const openLayers = Array.from(document.querySelectorAll(
        '.aui-dropdown2, .aui-dropdown, .aui-layer, .aui-inline-dialog'
      )).some(isVisible);

      toc.classList.toggle('toc-hidden-for-menu', openLayers);
    }

    document.addEventListener('click', function () {
      setTimeout(updateTocVisibility, 50);
    });

    document.addEventListener('keyup', function () {
      setTimeout(updateTocVisibility, 50);
    });

    const observer = new MutationObserver(updateTocVisibility);
    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class', 'style', 'aria-hidden']
    });
  })();
</script>
